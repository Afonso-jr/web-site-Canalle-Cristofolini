---
import Styles from "../../../styles/components-page/buttons/buttons.module.css";
import { FilledButton } from "../../../components/buttons/filledButton/filledButton";
import { IconFilledButton } from "../../../components/buttons/filledButton/iconFilledButton";
import { OutlinedButton } from "../../../components/buttons/outlinedButton/outlinedButton";
import { IconOutlinedButton } from "../../../components/buttons/outlinedButton/iconOutlinedButton";
import { GhostButton } from "../../../components/buttons/ghostButton/ghostButton";
import { IconGhostButton } from "../../../components/buttons/ghostButton/iconGhostButton";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
        <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
		<meta name="description" content="Fast, modern websites built for performance, SEO, and an exceptional user experience.">
		<meta name="generator" content={Astro.generator} />
		<title>Fast & Modern Websites</title>
	<body>
		<section class={ Styles.wrapper }>
			<h1>Botão Filled</h1>
			<div class={ Styles.buttonsWrapper }>
				<p>Large</p>
				<FilledButton rightIcon="arrowRight" leftIcon="arrowLeft">
					Com ambos os icones laterais
				</FilledButton>
				<FilledButton>Só texto</FilledButton>
				<IconFilledButton icon="information" />
				<IconFilledButton icon="information" disabled={ true } />
			</div>
			<div class={ Styles.buttonsWrapper }>
				<p>Mid</p>
				<FilledButton size="md" rightIcon="arrowRight" leftIcon="arrowLeft">
					Com ambos os icones laterais
				</FilledButton>
				<FilledButton size="md" >Só texto</FilledButton>
				<IconFilledButton size="md" icon="information" />
				<IconFilledButton size="md" icon="information" disabled={ true } />
			</div>
			<div class={ Styles.buttonsWrapper }>
				<p>Small</p>
				<FilledButton size="sm" rightIcon="arrowRight" leftIcon="arrowLeft">
					Com ambos os icones laterais
				</FilledButton>
				<FilledButton size="sm">Só texto</FilledButton>
				<IconFilledButton size="sm" icon="information" />
				<IconFilledButton size="sm" icon="information" disabled={ true } />
			</div>
			<div class={ Styles.buttonsWrapper }>
				<p>Secundary</p>
				<FilledButton variant="secundary" rightIcon="arrowRight" leftIcon="arrowLeft">
					Com ambos os icones laterais
				</FilledButton>
				<FilledButton variant="secundary">Só texto</FilledButton>
				<IconFilledButton variant="secundary" icon="information" />
			</div>
			<div class={ Styles.buttonsWrapper }>
				<p>Danger</p>
				<FilledButton variant="danger" rightIcon="arrowRight" leftIcon="arrowLeft">
					Com ambos os icones laterais
				</FilledButton>
				<FilledButton variant="danger">Só texto</FilledButton>
				<IconFilledButton variant="danger" icon="information" />
			</div>
			<div class={ Styles.buttonsWrapper }>
				<p>Neutral</p>
				<FilledButton variant="neutral" rightIcon="arrowRight" leftIcon="arrowLeft">
					Com ambos os icones laterais
				</FilledButton>
				<FilledButton variant="neutral">Só texto</FilledButton>
				<IconFilledButton variant="neutral" icon="information" />
			</div>
			<div class=`${Styles.buttonsWrapper} `>
				<p>Inverse</p>
				<div class={ Styles.inverse }>
					<FilledButton variant="inverse" rightIcon="arrowRight" leftIcon="arrowLeft">
						Com ambos os icones laterais
					</FilledButton>
					<FilledButton variant="inverse">Só texto</FilledButton>
					<IconFilledButton variant="inverse" icon="information" />
				</div>
			</div>
			<h1>Botão Outlined</h1>
			<div class={ Styles.buttonsWrapper }>
				<p>Large</p>
				<OutlinedButton rightIcon="arrowRight" leftIcon="arrowLeft">
					Com ambos os icones laterais
				</OutlinedButton>
				<OutlinedButton>Só texto</OutlinedButton>
				<IconOutlinedButton icon="information" />
				<IconOutlinedButton icon="information" disabled={ true } />
			</div>
			<div class={ Styles.buttonsWrapper }>
				<p>Mid</p>
				<OutlinedButton size="md" rightIcon="arrowRight" leftIcon="arrowLeft">
					Com ambos os icones laterais
				</OutlinedButton>
				<OutlinedButton size="md" >Só texto</OutlinedButton>
				<IconOutlinedButton size="md" icon="information" />
				<IconOutlinedButton size="md" icon="information" disabled={ true } />
			</div>
			<div class={ Styles.buttonsWrapper }>
				<p>Small</p>
				<OutlinedButton size="sm" rightIcon="arrowRight" leftIcon="arrowLeft">
					Com ambos os icones laterais
				</OutlinedButton>
				<OutlinedButton size="sm">Só texto</OutlinedButton>
				<IconOutlinedButton size="sm" icon="information" />
				<IconOutlinedButton size="sm" icon="information" disabled={ true } />
			</div>
			<h1>Botão Ghost</h1>
			<div class={ Styles.buttonsWrapper }>
				<p>Large</p>
				<GhostButton rightIcon="arrowRight" leftIcon="arrowLeft">
					Com ambos os icones laterais
				</GhostButton>
				<GhostButton>Só texto</GhostButton>
				<IconGhostButton icon="information" />
				<IconGhostButton icon="information" disabled={ true } />
			</div>
			<div class={ Styles.buttonsWrapper }>
				<p>Mid</p>
				<GhostButton size="md" rightIcon="arrowRight" leftIcon="arrowLeft">
					Com ambos os icones laterais
				</GhostButton>
				<GhostButton size="md" >Só texto</GhostButton>
				<IconGhostButton size="md" icon="information" />
				<IconGhostButton size="md" icon="information" disabled={ true } />
			</div>
			<div class={ Styles.buttonsWrapper }>
				<p>Small</p>
				<GhostButton size="sm" rightIcon="arrowRight" leftIcon="arrowLeft">
					Com ambos os icones laterais
				</GhostButton>
				<GhostButton size="sm">Só texto</GhostButton>
				<IconGhostButton size="sm" icon="information" />
				<IconGhostButton size="sm" icon="information" disabled={ true } />
			</div>
		</section>
	</body>
</html>


