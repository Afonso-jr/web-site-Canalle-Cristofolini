---
import Styles from '../../../styles/components-page/textField/textField.module.css';
import TextFieldInput from '../../../components/TextFieldInput/textFieldInput.astro';
---

<script type="module">
  import { emailValidator, nameValidator } from "/src/utils/validators";

  const setError = (fieldName, message) => {
    const input = document.querySelector(`[data-field="${fieldName}"]`);
    const errorText = document.querySelector(`[data-error-for="${fieldName}"]`);

    if (!input || !errorText) return;

    if (message) {
      input.classList.add("error");
      errorText.textContent = message;
      errorText.style.display = "block";
    } else {
      input.classList.remove("input-error");
      errorText.textContent = "";
      errorText.style.display = "none";
    }
  };

  const handleSubmit = (e) => {
    e.preventDefault();

    const form = e.target;
    const formData = new FormData(form);

    const name = formData.get("name");
    const email = formData.get("email");

    const nameError = nameValidator(name);
    const emailError = emailValidator(email);

    setError("name", nameError);
    setError("email", emailError);

    if (nameError || emailError) return;

    form.submit();
  };

  window.handleSubmit = handleSubmit;
</script>

<html lang="pt-br">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
          name="description"
          content="Fast, modern websites built for performance, SEO, and an exceptional user experience."
        />
        <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
        <title>SVG</title>
    </head>
    <body>
        <section class={ Styles.sectionWrapper }>
          <h1>Inputs</h1>
          <div ></div>
          <div class={ Styles.formWrapper }>
              <form method="POST" novalidate onsubmit="handleSubmit(event)">
              <TextFieldInput
                label="Nome"
                name="name"
              />
              <TextFieldInput
                label="Email"
                name="email"
                type="email"
              />
              <button type="submit">Enviar</button>
            </form>
          </div>
          </section>
    </body>
</html>
